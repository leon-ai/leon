            "required": [
              "blockId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "options"
        ],
        "additionalProperties": false
      }
    },
    "createComment": {
      "description": "Create a page/block comment or reply to an observed discussion.",
      "parameters": {
        "type": "object",
        "properties": {
          "options": {
            "type": "object",
            "properties": {
              "pageId": {
                "type": "string",
                "minLength": 1
              },
              "blockId": {
                "type": "string",
                "minLength": 1
              },
              "discussionId": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "options"
        ],
        "additionalProperties": false
      },
      "progressive_guidance": "Comments require comment capabilities. Post only when the owner asks to communicate; choose exactly one target."
    }
  }
}
