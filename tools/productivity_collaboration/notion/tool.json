                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "properties": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "databaseId",
              "title",
              "properties"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "options"
        ],
        "additionalProperties": false
