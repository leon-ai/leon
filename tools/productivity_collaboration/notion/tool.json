        "type": "object",
        "properties": {
          "options": {
            "type": "object",
            "properties": {
              "dataSourceId": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "maxLength": 2000
              },
              "properties": {
                "type": "object",
                "additionalProperties": true,
                "description": "Notion schema updates; null removes a property. Only apply explicitly requested schema changes."
              }
            },
            "required": [
              "dataSourceId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "options"
        ],
        "additionalProperties": false
      }
    },
    "listComments": {
      "description": "List unresolved comments on a page or block with pagination.",
      "parameters": {
        "type": "object",
        "properties": {
          "options": {
            "type": "object",
            "properties": {
              "blockId": {
                "type": "string",
                "minLength": 1
              },
              "cursor": {
                "type": "string",
                "minLength": 1,
                "description": "Use next_cursor from the previous response."
              },
              "pageSize": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
